{
  "manifest_version": 2,
  "name": "Random Simpsons Player",
  "version": "1.0",
  "description": "Reproduce un episodio aleatorio de Los Simpson en Disney+.",
  "permissions": ["tabs", "https://www.disneyplus.com/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["banner.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["simpsons_todas_temporadas.json"],
  "browser_specific_settings": {
    "gecko": {
      "id": "random-simpsons@example.com",
      "strict_min_version": "102.0"
    }
  }
}
